npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded documents
public/uploads/documents/*
!public/uploads/documents/.gitkeep
